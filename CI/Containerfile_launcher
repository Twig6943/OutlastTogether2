FROM ubuntu:24.04

# Warning nuitka x86 doesn't have this issue but if you're using the
# x64 version the depends.exe will give an error like mfc42.dll failed to import.
# and it's not fixable by running winetricks -q mfc42
# If you gotta compile for x64 you gotta put the working depends to the cache folder by doing
# mkdir -p $WINEPREFIX/prefix/drive_c/users/$USER/AppData/Local/Nuitka/Nuitka/Cache/downloads/depends/x86_64
# wget -O /build/depends22_x86.zip https://dependencywalker.com/depends22_x86.zip
# unzip /build/depends22_x86.zip -d /build/wine/prefix/drive_c/users/$USER/AppData/Local/Nuitka/Nuitka/Cache/downloads/depends/x86_64

ENV DEBIAN_FRONTEND=noninteractive
ENV PROTON_ENABLE_WAYLAND=1
ENV WINEPREFIX=/build/wine/prefix
ENV WINEDEBUG=fixme-all
ENV WINEDLLOVERRIDES="winemenubuilder.exe=d"
ENV XDG_RUNTIME_DIR=/build/xdg
#ENV WLR_RENDERER=pixman # DO NOT UNCOMMENT THIS UNLESS YOU HAVE TO
# Wine's Wayland driver needs an EGL context from the compositor, which requires
# cage to run with its GLES2 renderer and a real DRM render node. Without a GPU
# node cage silently falls back to the pixman renderer (no EGL/wl_drm) and Wine
# fails with "no driver could be loaded". Build with the host GPU exposed:
#     podman build --device /dev/dri -t outlast-launcher -f CI/Containerfile_launcher .
# Do NOT set LIBGL_ALWAYS_SOFTWARE here - it conflicts with the hardware device.

# ---- Dependencies ----
RUN dpkg --add-architecture i386 && \
    apt-get update && apt-get install -y \
        sudo curl wget gnupg2 ca-certificates tar xz-utils unzip \
        cage xwayland-run \
        winbind lib32gcc-s1 lib32stdc++6 libc6-i386 \
        libegl1 libegl1:i386 libgl1 libgl1:i386 libglx0 libglx0:i386 \
        libgl1-mesa-dri libgl1-mesa-dri:i386 \
        libvulkan1 libvulkan1:i386 mesa-vulkan-drivers mesa-vulkan-drivers:i386 \
    && rm -rf /var/lib/apt/lists/*

# ---- WineHQ ----
RUN mkdir -pm755 /etc/apt/keyrings && \
    curl -fsSL https://dl.winehq.org/wine-builds/winehq.key \
        -o /etc/apt/keyrings/winehq-archive.key && \
    curl -fsSL https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources \
        -o /etc/apt/sources.list.d/winehq-noble.sources && \
    apt-get update && \
    apt-get install -y --install-recommends winehq-devel && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY . .

# ---- Create prefix headlessly, set Wayland driver ----
RUN mkdir -p $WINEPREFIX $XDG_RUNTIME_DIR && \
    wineboot -u 2>/dev/null; \
    wineserver -w; \
    wine reg add "HKEY_CURRENT_USER\\Software\\Wine\\Drivers" \
        /v Graphics /t REG_SZ /d wayland /f 2>/dev/null; \
    wineserver -w; \
    echo "PREFIX READY"

# ---- Install Python + deps under cage (Wine uses Wayland driver) ----
# The first process that triggers desktop creation races the explorer it
# spawns: winewayland.drv is only loaded once explorer has set the desktop
# window's "__wine_display_device_guid" prop, so the triggering process gets
# "no driver could be loaded". Prime the desktop with a throwaway GUI run
# (fails benignly but lets explorer finish setting up), then run the real
# installer against the already-initialized desktop.
RUN wget -q https://www.python.org/ftp/python/3.12.9/python-3.12.9.exe && \
    wlheadless-run -c cage -- \
    sh -c 'wine wineserver --persistent; \
        wine C:\\windows\\system32\\notepad.exe 2>/dev/null; \
        sleep 2; \
        wine python-3.12.9.exe /quiet \
            InstallAllUsers=0 \
            Include_launcher=0 \
            Include_test=0 \
            Include_symbols=0 \
            Include_tcltk=1 \
            PrependPath=1 \
            TargetDir=C:\\Python312; \
        wineserver -k' && \
    rm -f python-3.12.9.exe && \
    wineserver -w && \
    echo "PYTHON INSTALLED"

RUN wlheadless-run -c cage -- \
    wine C:\\Python312\\python.exe -m pip install --no-python-version-warning \
        --disable-pip-version-check \
        nuitka zstandard ordered-set -r requirements.txt && \
    wineserver -w && \
    echo "PACKAGES INSTALLED"

# ---- Build Windows binary with Nuitka under cage ----
# Every gcc call runs under Wine (a full Wine process each), so disable LTO
# and ccache (ccache adds a second Wine process per file and has no benefit
# on a one-shot CI build) and give the step a generous timeout. `-u` keeps
# Nuitka progress visible in the build log instead of looking hung.
RUN wlheadless-run -c cage -- \
    sh -c 'wine wineserver --persistent; \
        wine C:\\windows\\system32\\notepad.exe 2>/dev/null; \
        sleep 2; \
        timeout 3600 wine C:\\Python312\\python.exe -u -m nuitka \
            --mingw64 \
            --assume-yes-for-downloads \
            --lto=no \
            --disable-ccache \
            --enable-plugin=tk-inter \
            --onefile \
            /build/OutlastTogether.py \
            --output-filename=/build/OutlastLauncher.exe; \
        NUITKA_EXIT=$?; \
        wineserver -k; \
        test $NUITKA_EXIT -eq 0' && \
    echo "BUILD SUCCESS"
